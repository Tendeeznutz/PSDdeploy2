# AirServe reverse proxy
# Caddy handles HTTPS termination (auto Let's Encrypt) and routes
# traffic to the backend API and Next.js frontend containers.
#
# Set DOMAIN env var in .env (e.g., DOMAIN=ay2526-tp-j.coding36.net)
# For local dev without HTTPS, use DOMAIN=:80

{$DOMAIN:localhost} {
    # API and admin routes → Django backend
    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /admin/* {
        reverse_proxy backend:8000
    }

    # Everything else → Next.js frontend
    handle {
        reverse_proxy frontend:3000
    }

    header {
        -Server
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }

    log {
        output stdout
        format console
    }
}
