# ================================================================
# AirServe Docker Stack — Environment Variables
# Copy to .env and fill in all values
# ================================================================

# ── Docker / Infrastructure ──────────────────────────────────
POSTGRES_USER=airserve
POSTGRES_PASSWORD=          # Generate a strong random password
POSTGRES_DB=airserve_db

MINIO_ROOT_USER=airserve
MINIO_ROOT_PASSWORD=        # Min 8 chars, generate a strong password
MINIO_BUCKET=airserve-media

GHCR_REPO=your-org/airserve-backend
DOMAIN=localhost            # Caddy: your-domain.com for auto-HTTPS, or :80 for HTTP-only
HTTP_PORT=80                # Host port for HTTP (use 8080 if port 80 is taken)
HTTPS_PORT=443              # Host port for HTTPS (use 8443 if port 443 is taken)

# ── Django Core ──────────────────────────────────────────────
SECRET_KEY=                 # python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEBUG=False                 # NEVER True in production
USE_HTTPS=True              # Set False if no TLS (e.g., school server without certs)

ALLOWED_HOSTS=              # Comma-separated: your-domain.com,your-vps-ip
CORS_ALLOWED_ORIGINS=       # Comma-separated: https://your-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=       # Comma-separated: https://your-domain.com (required for Django 4.x)
FRONTEND_BASE_URL=          # https://your-frontend.vercel.app

# ── Email (Gmail SMTP) ──────────────────────────────────────
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=        # Gmail App Password (not your account password)

# ── OneMap API ───────────────────────────────────────────────
ONEMAP_API_KEY=
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# ── Telegram Bot (optional) ─────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ── Scheduling Algorithm ─────────────────────────────────────
WALK_SEARCH_RANGE=1000
WALK_INCREMENT=500
DRIVE_SEARCH_RANGE=5000
DRIVE_INCREMENT=2500
CYCLE_SEARCH_RANGE=3000
CYCLE_INCREMENT=1500

# ── Seed Control ─────────────────────────────────────────────
RUN_SEED=false              # Set "true" on first deploy only
